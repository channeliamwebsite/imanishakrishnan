# Copy to .env.local and fill in. Never commit .env.local or real credentials.

# --- Firebase (public web config — identifies the project; access is enforced by Firestore rules) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Canonical site address (optional) ---
# The primary domain is set in .env.production (https://iamnisha.in). It overrides the "Site URL" in
# Admin → Settings → SEO for canonical URLs, Open Graph, JSON-LD, sitemap and robots, and is the
# target of the secondary-domain redirects in next.config.ts. Leave empty locally.
NEXT_PUBLIC_SITE_URL=

# --- Firebase Admin (server-only; scripts only: `npm run seed:firestore`, `npm run admin:grant`) ---
# Not needed by the website or the admin dashboard at runtime: admin sign-ins are verified with the
# public project id, and admin roles are checked under the Firestore rules (docs/cms-architecture.md).
# Service-account key JSON pasted on ONE line. Never prefix with NEXT_PUBLIC_, never commit it.
# Firebase Console → Project settings → Service accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Local testing only — never set these in production ---
# Point the site and admin at the Firebase emulators (`firebase emulators:start --only auth,firestore`).
# Use with NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-<anything> so nothing can reach the real project.
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Cloudinary ---
# Public: used to build/validate delivery URLs (res.cloudinary.com/<cloud name>/...).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Server-only (used to sign admin uploads and delete assets). Never prefix these with NEXT_PUBLIC_
# and never import lib/cloudinary/server.ts from client code.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
