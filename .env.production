# Committed on purpose: public, non-secret production settings only. Never put credentials here.
# Primary domain — canonical URLs, Open Graph, JSON-LD, sitemap.xml and robots.txt use it, and
# next.config.ts redirects secondary hosts to it. A value set in Vercel → Environment Variables
# takes precedence over this file.
NEXT_PUBLIC_SITE_URL=https://iamnisha.in
